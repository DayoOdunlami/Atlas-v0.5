# --- Primary shell (/ assistant-ui + LangGraph) ---
LANGGRAPH_API_URL=http://localhost:2024
NEXT_PUBLIC_LANGGRAPH_ASSISTANT_ID=atlas

# --- Python agents (CopilotKit lab /api/copilotkit) ---
# Local dev:
PYTHON_AGENTS_URL=http://localhost:8000
# Vercel (Project → Settings → Environment Variables) — REQUIRED for /atlas chat:
# PYTHON_AGENTS_URL=https://agents-production-d347.up.railway.app
# Railway agent service also needs: ANTHROPIC_API_KEY, SUPABASE_SERVICE_KEY,
# NEXT_PUBLIC_SUPABASE_URL, OPENAI_API_KEY (embeddings), EXA_API_KEY (web lane)

# --- LLM + corpus ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
POSTGRES_URL=postgresql://postgres.<project-ref>:<password>@aws-1-eu-west-1.pooler.supabase.com:6543/postgres?sslmode=require
NEXT_PUBLIC_SUPABASE_URL=https://afysgjiczzptubonbuxs.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=

# --- Atlas 5 dev tools ---
NEXT_PUBLIC_ATLAS5_DEV_SPLIT_VIEW=false   # Phase 2 gate: side-by-side blocks vs document

# --- Atlas 5 orchestrator (enable for live workbench MVP) ---
# Backend + frontend must both be true for /workbench orchestrator path.
ATLAS5_ORCHESTRATOR_V1=true
NEXT_PUBLIC_ATLAS5_ORCHESTRATOR_V1=true
ATLAS5_VIZ_ART_DIRECTOR_V1=false
ATLAS5_GENERATIVE_VIZ_V1=false
ATLAS5_HARMONIZED_EVIDENCE_V1=true

# --- Optional external scout ---
ATLAS5_FALSIFICATION_LANE_V1=false
TAVILY_API_KEY=
EXA_API_KEY=

# --- Corpus connectivity (corp VPN tuning) ---
# CORPUS_PG_PROBE_TIMEOUT=3      # seconds per Postgres attempt (default 3)
# CORPUS_PG_PROBE_ATTEMPTS=2     # retry once on slow links (default 2)
# CORPUS_PG_CONNECT_TIMEOUT=8    # timeout for full SQL queries (default 8)

# Legacy
GOOGLE_API_KEY=your-google-api-key
AGENT_URL=http://localhost:8000/
PORT=8000
