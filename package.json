{
  "name": "atlas-v0.5",
  "version": "0.5.0",
  "private": true,
  "scripts": {
    "dev": "concurrently -n \"ui,agents\" -c \"blue,green\" \"next dev --turbopack --port 3005\" \"node scripts/python-bin.mjs -m uvicorn agents.server:app --port 8000 --reload --reload-dir agents --reload-dir mcps --reload-delay 1\"",
    "dev:ui": "next dev --turbopack --port 3005",
    "dev:agents": "node scripts/python-bin.mjs -m uvicorn agents.server:app --port 8000 --reload --reload-dir agents --reload-dir mcps --reload-delay 1",
    "dev:lg": "node scripts/langgraph-dev.mjs dev --port 2024",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "eval:tier1": "vitest run --config eval/vitest.atlas5.config.ts",
    "eval:workbench": "vitest run --config eval/vitest.atlas5.config.ts eval/workbench-tier1.test.ts eval/workbench-tier2.test.ts eval/density-audit.test.ts",
    "eval:workbench:agent": "node scripts/python-bin.mjs agents/test_workbench_patch.py && node scripts/python-bin.mjs agents/test_corpus_transport.py",
    "eval:parity": "node scripts/python-bin.mjs eval/test_parity_gate.py",
    "eval:parity:live": "node scripts/python-bin.mjs eval/test_parity_gate.py --live",
    "eval:contract": "node scripts/python-bin.mjs eval/test_artifact_contract_live.py",
    "eval:contract:live": "node scripts/python-bin.mjs eval/test_artifact_contract_live.py --live",
    "eval:sprint5": "node scripts/python-bin.mjs agents/test_citation_guard.py && node scripts/python-bin.mjs agents/test_turn_intent.py && node scripts/python-bin.mjs agents/test_session_lanes.py && node scripts/python-bin.mjs agents/test_artifact_qa.py && node scripts/python-bin.mjs agents/test_falsification.py && node scripts/python-bin.mjs eval/test_artifact_contract_live.py",
    "eval:sprint5:gates": "node eval/sprint5/scripts/check-sprint5-gates.mjs",
    "bundle:surfaces": "node scripts/bundle-surface-export.mjs",
    "eval:horsemen": "node scripts/python-bin.mjs eval/test_four_horsemen.py",
    "eval:orchestrator": "node scripts/python-bin.mjs -m pytest agents/test_outcome_quality.py agents/test_diagnose_ui_seam.py agents/test_outcome_builders.py agents/test_value_translation.py agents/test_eval_battery.py agents/test_eval_trajectories.py agents/test_eval_api.py agents/test_chat_path.py agents/test_demo_scenarios.py agents/test_orchestrator_e2e.py agents/test_presentation.py agents/test_evidence_router_lanes.py agents/test_reconcile_harmonized.py agents/test_harmonized_evidence.py agents/test_multiturn_context.py agents/test_diagnose_honesty.py eval/latency_budget.py -q",
    "eval:pic": "playwright test eval/pic_session.spec.ts --config eval/playwright.orchestrator.config.ts",
    "eval:chat-path": "node scripts/python-bin.mjs -m pytest agents/test_chat_path.py -q",
    "eval:genui": "node scripts/python-bin.mjs -m agents.atlas_v5.genui_eval",
    "eval:calibration": "node scripts/python-bin.mjs -m agents.atlas_v5.calibration_eval",
    "eval:calibration:heuristic": "node scripts/python-bin.mjs -m agents.atlas_v5.calibration_eval --heuristic-only",
    "eval:v5-trajectories": "node scripts/python-bin.mjs eval/run_atlas_v5_trajectories.py",
    "eval:v5-trajectories:quick": "node scripts/python-bin.mjs eval/run_atlas_v5_trajectories.py --id V01_hello --id V02_rail_orient_followup",
    "eval:v5-threads": "npx vitest run --config eval/vitest.atlas5.config.ts eval/atlas-v5-threads.test.ts && node scripts/python-bin.mjs -m pytest agents/test_persist_turn.py -q",
    "db:migrate:atlas": "node scripts/apply-atlas-migrations.mjs",
    "eval:v5-session": "playwright test --config eval/playwright.atlas-v5.config.ts",
    "eval:v5-session:smoke": "playwright test --config eval/playwright.atlas-v5.config.ts --grep E2E-3",
    "eval:demo-scenarios": "node scripts/python-bin.mjs -m pytest agents/test_demo_scenarios.py -q",
    "eval:battery": "node scripts/python-bin.mjs eval/run_battery.py --no-judge",
    "eval:battery:judge": "node scripts/python-bin.mjs eval/run_battery.py",
    "eval:battery:quick": "node scripts/python-bin.mjs eval/run_battery.py --limit 5 --no-judge",
    "eval:trajectories": "node scripts/python-bin.mjs eval/run_trajectories.py",
    "eval:full": "npm run eval:orchestrator && npm run eval:battery && npm run eval:trajectories",
    "eval:orchestrator:playwright": "playwright test --config eval/playwright.orchestrator.config.ts",
    "eval:mvp-gate": "playwright test --config eval/playwright.orchestrator.config.ts",
    "demo:check": "node eval/demo/check-prereqs.mjs",
    "demo:record": "node eval/demo/check-prereqs.mjs && playwright test --config eval/demo/playwright.demo.config.ts",
    "eval:tier2": "python eval/tier2_generator.py",
    "eval:golden": "python eval/tier2_generator.py --golden",
    "check-types": "tsc --noEmit",
    "agents:start": "node scripts/python-bin.mjs -m uvicorn agents.server:app --port 8000 --reload --reload-dir agents --reload-dir mcps --reload-delay 1",
    "agents:setup": "node scripts/setup-agents.mjs",
    "agents:bench": "node scripts/python-bin.mjs agents/atlas_v5/bench_turn_stages.py",
    "agents:verify": "node scripts/python-bin.mjs -c \"import httpx, json; r = httpx.post('http://localhost:8000/agents/jarvis', json={'query':'autonomous freight corridors UK'}); print(json.dumps(r.json(), indent=2))\""
  },
  "dependencies": {
    "@ag-ui/client": "^0.0.38",
    "@ai-sdk/anthropic": "^2.0.56",
    "@ai-sdk/openai": "^1.3.22",
    "@anthropic-ai/sdk": "^0.87.0",
    "@antv/g2": "^5.4.8",
    "@antv/g6": "^5.1.1",
    "@assistant-ui/react": "^0.14.0",
    "@assistant-ui/react-langgraph": "^0.14.0",
    "@assistant-ui/react-markdown": "^0.14.0",
    "@copilotkit/react-core": "1.10.4",
    "@copilotkit/react-ui": "1.10.4",
    "@copilotkit/runtime": "1.10.4",
    "@copilotkit/runtime-client-gql": "1.10.4",
    "@langchain/langgraph-sdk": "^1.9.0",
    "@radix-ui/react-avatar": "^1.1.10",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-progress": "^1.1.7",
    "@radix-ui/react-separator": "^1.1.7",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@radix-ui/react-use-controllable-state": "^1.2.3",
    "@supabase/ssr": "^0.6.1",
    "@supabase/supabase-js": "^2.103.0",
    "@xyflow/react": "^12.10.2",
    "ai": "^5.0.116",
    "better-auth": "^1.4.9",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.1.0",
    "echarts": "^5.6.0",
    "echarts-for-react": "^3.0.2",
    "flowtoken": "^1.0.40",
    "framer-motion": "^12.23.26",
    "geist": "^1.5.1",
    "lucide-react": "^0.544.0",
    "mammoth": "^1.12.0",
    "nanoid": "^5.1.6",
    "next": "15.5.15",
    "next-themes": "^0.4.6",
    "pdf-parse": "^2.4.5",
    "pg": "^8.21.0",
    "radix-ui": "^1.4.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "react-resizable-panels": "^2.1.9",
    "recharts": "^2.15.4",
    "remark-gfm": "^4.0.1",
    "server-only": "^0.0.1",
    "sonner": "^2.0.7",
    "swr": "^2.3.8",
    "tailwind-merge": "^3.3.1",
    "tldraw": "^3.15.4",
    "tw-shimmer": "^0.4.11",
    "vega": "^6.2.0",
    "vega-embed": "^7.1.0",
    "vega-lite": "^6.4.3",
    "xlsx": "^0.18.5",
    "zod": "^3.24.4",
    "zustand": "^5.0.9"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@tailwindcss/postcss": "^4",
    "@tailwindcss/typography": "^0.5.16",
    "@types/node": "^20",
    "@types/pg": "^8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/ui": "^3.1.0",
    "concurrently": "^9.1.2",
    "dotenv": "^17.4.2",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.3.8",
    "typescript": "^5",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^3.1.0"
  }
}
